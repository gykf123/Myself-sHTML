# ---------- 本地/敏感文件，绝不进仓库 ----------
# 个人 GitHub 访问恢复脚本（含个人网络配置，按 REMIND 永不提交）
github_access_setup.sh

# 密钥文件（PAT / service_role / JWT secret 等，任何形式都不进仓库）
*.pat.env
pat.env
.env
*.key
secrets.*

# 本地生成/预览用资源（不入仓库）
preview-*.png
*.preview.png
*.log

# 浏览器验收截图（仅沙箱留存供查看，不进仓库）
verify/

# Supabase CLI 本地链接状态（含项目 ref / 组织信息，仅本机有效）
supabase/.temp/

# Node 依赖由 GitHub Actions 用 package-lock.json 现场安装（npm ci），绝不提交
node_modules/